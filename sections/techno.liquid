{% liquid
  assign section_uid = 'light-benefits-' | append: section.id
%}

<section
  id="{{ section_uid }}"
  class="light-benefits"
  style="
    --lb-bg: {{ section.settings.background_color }};
    --lb-text: {{ section.settings.text_color }};
    --lb-muted: {{ section.settings.muted_color }};
    --lb-accent: {{ section.settings.accent_color }};
    --lb-line: {{ section.settings.line_color }};
    --lb-max-width: {{ section.settings.max_width }}px;
  "
>

  <div class="light-benefits__container">

    <!-- =========================
         EN-TÊTE
    ========================== -->

    <div class="light-benefits__header">

      {% if section.settings.eyebrow != blank %}
        <div class="light-benefits__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}


      <div class="light-benefits__heading-wrap">

        {% if section.settings.heading != blank %}
          <h2 class="light-benefits__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.heading_accent != blank %}
          <div class="light-benefits__heading-accent">
            {{ section.settings.heading_accent }}
          </div>
        {% endif %}

      </div>


      {% if section.settings.description != blank %}
        <div class="light-benefits__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    <!-- =========================
         CONTENU PC
    ========================== -->

    <div class="light-benefits__grid">


      <!-- COLONNE GAUCHE -->

      <div class="light-benefits__column light-benefits__column--left">

        {% for block in section.blocks %}

          {% if block.settings.position == 'left' %}

            <div
              class="light-benefits__item light-benefits__item--left"
              {{ block.shopify_attributes }}
            >

              <div class="light-benefits__item-heading">

                <span
                  class="light-benefits__dot"
                  style="background: {{ block.settings.dot_color }};"
                ></span>


                {% if block.settings.title != blank %}
                  <h3 class="light-benefits__item-title">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}

              </div>


              <div
                class="light-benefits__item-line"
                style="background: {{ block.settings.line_color }};"
              ></div>


              {% if block.settings.text != blank %}
                <div class="light-benefits__item-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>



      <!-- =========================
           IMAGE CENTRALE
      ========================== -->

      <div class="light-benefits__visual">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(max-width: 749px) 100vw, 34vw',
              class: 'light-benefits__image'
          }}

        {% else %}

          {{ 'product-1' | placeholder_svg_tag: 'light-benefits__placeholder' }}

        {% endif %}

      </div>



      <!-- =========================
           COLONNE DROITE
      ========================== -->

      <div class="light-benefits__column light-benefits__column--right">

        {% for block in section.blocks %}

          {% if block.settings.position == 'right' %}

            <div
              class="light-benefits__item light-benefits__item--right"
              {{ block.shopify_attributes }}
            >

              <div class="light-benefits__item-heading">

                {% if block.settings.title != blank %}
                  <h3 class="light-benefits__item-title">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}


                <span
                  class="light-benefits__dot"
                  style="background: {{ block.settings.dot_color }};"
                ></span>

              </div>


              <div
                class="light-benefits__item-line"
                style="background: {{ block.settings.line_color }};"
              ></div>


              {% if block.settings.text != blank %}
                <div class="light-benefits__item-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>

    </div>



    <!-- =========================
         CONTENU MOBILE
    ========================== -->

    <div class="light-benefits__mobile-list">

      {% for block in section.blocks %}

        <div
          class="light-benefits__mobile-item"
          {{ block.shopify_attributes }}
        >

          <div class="light-benefits__item-heading">

            <span
              class="light-benefits__dot"
              style="background: {{ block.settings.dot_color }};"
            ></span>


            {% if block.settings.title != blank %}
              <h3 class="light-benefits__item-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

          </div>


          <div
            class="light-benefits__item-line"
            style="background: {{ block.settings.line_color }};"
          ></div>


          {% if block.settings.text != blank %}
            <div class="light-benefits__item-text">
              {{ block.settings.text }}
            </div>
          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>

</section>


<style>

  /* =====================================================
     GLOBAL
  ====================================================== */

  #{{ section_uid }} {

    width: 100%;

    overflow: hidden;

    background: var(--lb-bg);

    color: var(--lb-text);

    padding-top: {{ section.settings.padding_top }}px;

    padding-bottom: {{ section.settings.padding_bottom }}px;

  }


  #{{ section_uid }} *,
  #{{ section_uid }} *::before,
  #{{ section_uid }} *::after {

    box-sizing: border-box;

  }


  #{{ section_uid }} .light-benefits__container {

    width: 100%;

    max-width: var(--lb-max-width);

    margin: 0 auto;

    padding-left: {{ section.settings.side_padding }}px;

    padding-right: {{ section.settings.side_padding }}px;

  }



  /* =====================================================
     HEADER
  ====================================================== */

  #{{ section_uid }} .light-benefits__header {

    width: 100%;

    max-width: {{ section.settings.header_width }}px;

    margin:
      0
      auto
      {{ section.settings.header_bottom_space }}px;

    text-align: {{ section.settings.header_alignment }};

  }


  #{{ section_uid }} .light-benefits__eyebrow {

    margin-bottom: {{ section.settings.eyebrow_bottom_space }}px;

    color: var(--lb-accent);

    font-size: {{ section.settings.eyebrow_size }}px;

    font-weight: 700;

    line-height: 1.2;

    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;

    text-transform: uppercase;

  }



  /* =====================================================
     TITRE
  ====================================================== */

  #{{ section_uid }} .light-benefits__heading-wrap {

    display: flex;

    flex-wrap: wrap;

    align-items: baseline;

    justify-content:
      {% if section.settings.header_alignment == 'center' %}
        center
      {% elsif section.settings.header_alignment == 'right' %}
        flex-end
      {% else %}
        flex-start
      {% endif %};

    column-gap: 8px;

    row-gap: 0;

  }


  #{{ section_uid }} .light-benefits__heading {

    margin: 0;

    color: var(--lb-text);

    font-size: {{ section.settings.heading_size }}px;

    font-weight: {{ section.settings.heading_weight }};

    line-height: 1.08;

    letter-spacing: -1px;

  }


  #{{ section_uid }} .light-benefits__heading-accent {

    color: var(--lb-accent);

    font-size: {{ section.settings.heading_size }}px;

    font-weight: 400;

    font-style:
      {% if section.settings.accent_italic %}
        italic
      {% else %}
        normal
      {% endif %};

    line-height: 1.08;

    letter-spacing: -1px;

  }



  /* =====================================================
     DESCRIPTION
  ====================================================== */

  #{{ section_uid }} .light-benefits__description {

    max-width: {{ section.settings.description_width }}px;

    margin-top: {{ section.settings.description_top_space }}px;

    {% if section.settings.header_alignment == 'center' %}

      margin-left: auto;

      margin-right: auto;

    {% elsif section.settings.header_alignment == 'right' %}

      margin-left: auto;

    {% endif %}

    color: var(--lb-text);

    font-size: {{ section.settings.description_size }}px;

    font-weight: 400;

    line-height: 1.45;

  }


  #{{ section_uid }} .light-benefits__description p {

    margin: 0;

  }



  /* =====================================================
     LAYOUT PC
  ====================================================== */

  #{{ section_uid }} .light-benefits__grid {

    width: 100%;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, {{ section.settings.image_column_width }}fr)
      minmax(0, 1fr);

    align-items: center;

    gap: {{ section.settings.column_gap }}px;

  }



  /* =====================================================
     COLONNES
  ====================================================== */

  #{{ section_uid }} .light-benefits__column {

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    min-height: {{ section.settings.image_height }}px;

    padding-top: {{ section.settings.column_vertical_padding }}px;

    padding-bottom: {{ section.settings.column_vertical_padding }}px;

  }


  #{{ section_uid }} .light-benefits__item {

    width: 100%;

    max-width: {{ section.settings.benefit_max_width }}px;

  }


  #{{ section_uid }} .light-benefits__item--left {

    margin-right: auto;

    text-align: left;

  }


  #{{ section_uid }} .light-benefits__item--right {

    margin-left: auto;

    text-align: right;

  }



  /* =====================================================
     TITRE BÉNÉFICE
  ====================================================== */

  #{{ section_uid }} .light-benefits__item-heading {

    display: flex;

    align-items: center;

    gap: {{ section.settings.dot_title_gap }}px;

  }


  #{{ section_uid }}
  .light-benefits__item--right
  .light-benefits__item-heading {

    justify-content: flex-end;

  }


  #{{ section_uid }} .light-benefits__dot {

    width: {{ section.settings.dot_size }}px;

    height: {{ section.settings.dot_size }}px;

    flex: 0 0 {{ section.settings.dot_size }}px;

    display: block;

    border-radius: 50%;

  }


  #{{ section_uid }} .light-benefits__item-title {

    margin: 0;

    color: var(--lb-text);

    font-size: {{ section.settings.benefit_title_size }}px;

    font-weight: 700;

    line-height: 1.25;

    text-transform:
      {% if section.settings.uppercase_titles %}
        uppercase
      {% else %}
        none
      {% endif %};

  }



  /* =====================================================
     LIGNE
  ====================================================== */

  #{{ section_uid }} .light-benefits__item-line {

    width: 100%;

    height: {{ section.settings.line_height }}px;

    margin-top: {{ section.settings.line_top_space }}px;

    margin-bottom: {{ section.settings.line_bottom_space }}px;

  }



  /* =====================================================
     TEXTE
  ====================================================== */

  #{{ section_uid }} .light-benefits__item-text {

    color: var(--lb-text);

    font-size: {{ section.settings.benefit_text_size }}px;

    font-weight: 400;

    line-height: 1.5;

  }


  #{{ section_uid }} .light-benefits__item-text p {

    margin: 0;

  }


  #{{ section_uid }} .light-benefits__item-text strong {

    font-weight: 700;

  }



  /* =====================================================
     IMAGE
  ====================================================== */

  #{{ section_uid }} .light-benefits__visual {

    position: relative;

    width: 100%;

    height: {{ section.settings.image_height }}px;

    overflow: hidden;

    border-radius: {{ section.settings.image_radius }}px;

    background: {{ section.settings.image_background }};

  }


  #{{ section_uid }} .light-benefits__image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: {{ section.settings.image_fit }};

    object-position: {{ section.settings.image_position }};

  }


  #{{ section_uid }} .light-benefits__placeholder {

    width: 100%;

    height: 100%;

    display: block;

  }



  /* =====================================================
     MOBILE CACHÉ SUR PC
  ====================================================== */

  #{{ section_uid }} .light-benefits__mobile-list {

    display: none;

  }



  /* =====================================================
     TABLETTE
  ====================================================== */

  @media screen and (max-width: 989px) {

    #{{ section_uid }} .light-benefits__grid {

      gap: 25px;

    }


    #{{ section_uid }} .light-benefits__heading,
    #{{ section_uid }} .light-benefits__heading-accent {

      font-size: calc({{ section.settings.heading_size }}px * 0.85);

    }


    #{{ section_uid }} .light-benefits__item-title {

      font-size: calc({{ section.settings.benefit_title_size }}px - 1px);

    }


    #{{ section_uid }} .light-benefits__item-text {

      font-size: calc({{ section.settings.benefit_text_size }}px - 1px);

    }

  }



  /* =====================================================
     MOBILE
  ====================================================== */

  @media screen and (max-width: 749px) {

    #{{ section_uid }} {

      padding-top: {{ section.settings.mobile_padding_top }}px;

      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;

    }


    #{{ section_uid }} .light-benefits__container {

      padding-left: {{ section.settings.mobile_side_padding }}px;

      padding-right: {{ section.settings.mobile_side_padding }}px;

    }



    /* HEADER */

    #{{ section_uid }} .light-benefits__header {

      max-width: none;

      margin-bottom: {{ section.settings.mobile_header_bottom_space }}px;

      text-align: {{ section.settings.mobile_header_alignment }};

    }


    #{{ section_uid }} .light-benefits__eyebrow {

      margin-bottom: {{ section.settings.mobile_eyebrow_bottom_space }}px;

      font-size: {{ section.settings.mobile_eyebrow_size }}px;

      letter-spacing: 1.2px;

    }


    #{{ section_uid }} .light-benefits__heading-wrap {

      justify-content:
        {% if section.settings.mobile_header_alignment == 'center' %}
          center
        {% elsif section.settings.mobile_header_alignment == 'right' %}
          flex-end
        {% else %}
          flex-start
        {% endif %};

      column-gap: 6px;

    }


    #{{ section_uid }} .light-benefits__heading,
    #{{ section_uid }} .light-benefits__heading-accent {

      font-size: {{ section.settings.mobile_heading_size }}px;

      line-height: 1.08;

      letter-spacing: -0.6px;

    }


    #{{ section_uid }} .light-benefits__description {

      max-width: none;

      margin-top: {{ section.settings.mobile_description_top_space }}px;

      font-size: {{ section.settings.mobile_description_size }}px;

      line-height: 1.45;

    }



    /* GRID */

    #{{ section_uid }} .light-benefits__grid {

      display: block;

    }


    #{{ section_uid }} .light-benefits__column {

      display: none;

    }



    /* IMAGE */

    #{{ section_uid }} .light-benefits__visual {

      height: {{ section.settings.mobile_image_height }}px;

      margin-bottom: {{ section.settings.mobile_image_bottom_space }}px;

      border-radius: {{ section.settings.mobile_image_radius }}px;

    }



    /* LISTE MOBILE */

    #{{ section_uid }} .light-benefits__mobile-list {

      display: flex;

      flex-direction: column;

      gap: {{ section.settings.mobile_benefit_gap }}px;

    }


    #{{ section_uid }} .light-benefits__mobile-item {

      width: 100%;

      text-align: left;

    }


    #{{ section_uid }}
    .light-benefits__mobile-item
    .light-benefits__item-heading {

      justify-content: flex-start;

      gap: {{ section.settings.mobile_dot_title_gap }}px;

    }


    #{{ section_uid }}
    .light-benefits__mobile-item
    .light-benefits__dot {

      width: {{ section.settings.mobile_dot_size }}px;

      height: {{ section.settings.mobile_dot_size }}px;

      flex-basis: {{ section.settings.mobile_dot_size }}px;

    }


    #{{ section_uid }}
    .light-benefits__mobile-item
    .light-benefits__item-title {

      font-size: {{ section.settings.mobile_benefit_title_size }}px;

    }


    #{{ section_uid }}
    .light-benefits__mobile-item
    .light-benefits__item-text {

      font-size: {{ section.settings.mobile_benefit_text_size }}px;

      line-height: 1.45;

    }


    #{{ section_uid }}
    .light-benefits__mobile-item
    .light-benefits__item-line {

      margin-top: {{ section.settings.mobile_line_top_space }}px;

      margin-bottom: {{ section.settings.mobile_line_bottom_space }}px;

    }

  }

</style>


{% schema %}
{
  "name": "Technologies & bénéfices",
  "tag": "section",
  "class": "section-light-benefits",

  "settings": [

    {
      "type": "header",
      "content": "En-tête"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "PLUS DE BÉNÉFICES & DE COUVERTURE"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Quatre longueurs d'onde,"
    },

    {
      "type": "text",
      "id": "heading_accent",
      "label": "Partie colorée du titre",
      "default": "un seul masque"
    },

    {
      "type": "checkbox",
      "id": "accent_italic",
      "label": "Mettre la partie colorée en italique",
      "default": true
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Chaque longueur d'onde cible un besoin différent pour offrir une routine plus complète.</p>"
    },

    {
      "type": "select",
      "id": "header_alignment",
      "label": "Alignement en-tête PC",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "left"
    },


    {
      "type": "header",
      "content": "Image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image centrale"
    },

    {
      "type": "range",
      "id": "image_column_width",
      "label": "Largeur relative de l'image",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.4
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Hauteur image PC",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },

    {
      "type": "range",
      "id": "image_radius",
      "label": "Arrondi image PC",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Adaptation image",
      "options": [
        {
          "value": "cover",
          "label": "Remplir"
        },
        {
          "value": "contain",
          "label": "Afficher entière"
        }
      ],
      "default": "cover"
    },

    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Haut"
        },
        {
          "value": "bottom",
          "label": "Bas"
        },
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "center"
    },

    {
      "type": "color",
      "id": "image_background",
      "label": "Fond derrière l'image",
      "default": "#F2F2F2"
    },


    {
      "type": "header",
      "content": "Typographie PC"
    },

    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Taille petit titre",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },

    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "label": "Espacement lettres petit titre",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre",
      "min": 26,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "select",
      "id": "heading_weight",
      "label": "Graisse du titre",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "500"
    },

    {
      "type": "range",
      "id": "description_size",
      "label": "Taille description",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "range",
      "id": "benefit_title_size",
      "label": "Titre des bénéfices",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "benefit_text_size",
      "label": "Texte des bénéfices",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "checkbox",
      "id": "uppercase_titles",
      "label": "Titres bénéfices en majuscules",
      "default": true
    },


    {
      "type": "header",
      "content": "Bénéfices"
    },

    {
      "type": "range",
      "id": "benefit_max_width",
      "label": "Largeur maximale d'un bénéfice",
      "min": 220,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 330
    },

    {
      "type": "range",
      "id": "dot_size",
      "label": "Taille des pastilles",
      "min": 6,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },

    {
      "type": "range",
      "id": "dot_title_gap",
      "label": "Espace pastille / titre",
      "min": 5,
      "max": 25,
      "step": 1,
      "unit": "px",
      "default": 9
    },

    {
      "type": "range",
      "id": "line_height",
      "label": "Épaisseur séparateur",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },

    {
      "type": "range",
      "id": "line_top_space",
      "label": "Espace avant séparateur",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "line_bottom_space",
      "label": "Espace après séparateur",
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "column_vertical_padding",
      "label": "Marge verticale des colonnes",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
