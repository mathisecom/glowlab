{% liquid
  assign hero_id = 'brand-image-hero-' | append: section.id
%}

<section
  id="{{ hero_id }}"
  class="brand-image-hero"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-muted: {{ section.settings.muted_color }};
    --hero-stars: {{ section.settings.star_color }};
    --hero-button-bg: {{ section.settings.button_background }};
    --hero-button-text: {{ section.settings.button_text_color }};
    --hero-max-width: {{ section.settings.max_width }}px;
  "
>

  <div class="brand-image-hero__inner">

    <div
      class="
        brand-image-hero__grid
        {% if section.settings.image_position == 'left' %}
          brand-image-hero__grid--image-left
        {% else %}
          brand-image-hero__grid--image-right
        {% endif %}
      "
    >

      <!-- ==================================================
           CONTENU
      =================================================== -->

      <div class="brand-image-hero__content">

        {% if section.settings.show_rating %}
          <div class="brand-image-hero__rating">

            <div
              class="brand-image-hero__stars"
              aria-label="{{ section.settings.rating }} étoiles sur 5"
            >
              ★★★★★
            </div>

            {% if section.settings.rating_text != blank %}
              <div class="brand-image-hero__rating-text">
                {{ section.settings.rating_text }}
              </div>
            {% endif %}

          </div>
        {% endif %}


        {% if section.settings.eyebrow != blank %}
          <div class="brand-image-hero__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}


        {% if section.settings.heading != blank %}
          <h2 class="brand-image-hero__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.description != blank %}
          <div class="brand-image-hero__description">
            {{ section.settings.description }}
          </div>
        {% endif %}


        {% if section.settings.button_label != blank %}
          <a
            class="brand-image-hero__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}

      </div>


      <!-- ==================================================
           IMAGE
      =================================================== -->

      <div class="brand-image-hero__visual">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600, 2000',
              sizes: '(max-width: 749px) 100vw, 50vw',
              class: 'brand-image-hero__image'
          }}

        {% else %}

          {{ 'image' | placeholder_svg_tag: 'brand-image-hero__placeholder' }}

        {% endif %}

      </div>

    </div>

  </div>

</section>


<style>

  /* ======================================================
     GLOBAL
  ====================================================== */

  #{{ hero_id }} {
    width: 100%;

    overflow: hidden;

    background: var(--hero-bg);
    color: var(--hero-text);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    font-family: inherit;
  }


  #{{ hero_id }} *,
  #{{ hero_id }} *::before,
  #{{ hero_id }} *::after {
    box-sizing: border-box;
  }


  #{{ hero_id }} .brand-image-hero__inner {
    width: 100%;
    max-width: var(--hero-max-width);

    margin: 0 auto;

    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }



  /* ======================================================
     GRID PC
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__grid {
    display: grid;

    grid-template-columns:
      minmax(0, {{ section.settings.content_width }}fr)
      minmax(0, {{ section.settings.image_width }}fr);

    align-items: stretch;

    gap: {{ section.settings.desktop_gap }}px;
  }


  #{{ hero_id }} .brand-image-hero__grid--image-left
  .brand-image-hero__content {
    order: 2;
  }


  #{{ hero_id }} .brand-image-hero__grid--image-left
  .brand-image-hero__visual {
    order: 1;
  }


  #{{ hero_id }} .brand-image-hero__grid--image-right
  .brand-image-hero__content {
    order: 1;
  }


  #{{ hero_id }} .brand-image-hero__grid--image-right
  .brand-image-hero__visual {
    order: 2;
  }



  /* ======================================================
     CONTENU
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__content {
    display: flex;
    flex-direction: column;

    justify-content: center;

    max-width: {{ section.settings.content_max_width }}px;

    padding-top: {{ section.settings.content_padding_vertical }}px;
    padding-bottom: {{ section.settings.content_padding_vertical }}px;
  }



  /* ======================================================
     AVIS
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: {{ section.settings.rating_bottom_space }}px;
  }


  #{{ hero_id }} .brand-image-hero__stars {
    color: var(--hero-stars);

    font-size: {{ section.settings.star_size }}px;

    line-height: 1;

    letter-spacing: 1px;

    white-space: nowrap;
  }


  #{{ hero_id }} .brand-image-hero__rating-text {
    color: var(--hero-muted);

    font-size: {{ section.settings.rating_text_size }}px;
    font-weight: 500;

    line-height: 1.3;
  }



  /* ======================================================
     SUR-TITRE
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__eyebrow {
    margin-bottom: {{ section.settings.eyebrow_bottom_space }}px;

    color: var(--hero-accent);

    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;

    line-height: 1.2;

    letter-spacing: {{ section.settings.eyebrow_spacing }}px;

    text-transform: uppercase;
  }



  /* ======================================================
     TITRE
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__heading {
    max-width: {{ section.settings.heading_width }}px;

    margin:
      0
      0
      {{ section.settings.heading_bottom_space }}px;

    color: var(--hero-text);

    font-family: inherit;

    font-size: {{ section.settings.heading_size }}px;

    font-weight: {{ section.settings.heading_weight }};

    line-height: {{ section.settings.heading_line_height }};

    letter-spacing: -1px;
  }



  /* ======================================================
     DESCRIPTION
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__description {
    max-width: {{ section.settings.description_width }}px;

    margin-bottom: {{ section.settings.description_bottom_space }}px;

    color: var(--hero-text);

    font-size: {{ section.settings.description_size }}px;

    font-weight: 400;

    line-height: 1.5;
  }


  #{{ hero_id }} .brand-image-hero__description p {
    margin: 0;
  }



  /* ======================================================
     BOUTON
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__button {
    width: fit-content;

    min-height: {{ section.settings.button_height }}px;

    padding:
      10px
      {{ section.settings.button_horizontal_padding }}px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    background: var(--hero-button-bg);

    color: var(--hero-button-text);

    border:
      {{ section.settings.button_border_width }}px
      solid
      {{ section.settings.button_border_color }};

    border-radius: {{ section.settings.button_radius }}px;

    font-family: inherit;

    font-size: {{ section.settings.button_text_size }}px;
    font-weight: 700;

    line-height: 1;

    text-decoration: none;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }


  #{{ hero_id }} .brand-image-hero__button:hover {
    opacity: 0.9;

    transform: translateY(-1px);
  }



  /* ======================================================
     IMAGE
  ====================================================== */

  #{{ hero_id }} .brand-image-hero__visual {
    width: 100%;

    height: {{ section.settings.image_height }}px;

    overflow: hidden;

    border-radius: {{ section.settings.image_radius }}px;

    background: #f4f4f4;
  }


  #{{ hero_id }} .brand-image-hero__image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: {{ section.settings.image_fit }};

    object-position: {{ section.settings.image_position_y }};
  }


  #{{ hero_id }} .brand-image-hero__placeholder {
    width: 100%;
    height: 100%;

    display: block;
  }



  /* ======================================================
     TABLETTE
  ====================================================== */

  @media screen and (max-width: 989px) {

    #{{ hero_id }} .brand-image-hero__grid {
      gap: 35px;
    }


    #{{ hero_id }} .brand-image-hero__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.83);
    }


    #{{ hero_id }} .brand-image-hero__visual {
      height: calc({{ section.settings.image_height }}px * 0.82);
    }

  }



  /* ======================================================
     MOBILE
  ====================================================== */

  @media screen and (max-width: 749px) {

    #{{ hero_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    #{{ hero_id }} .brand-image-hero__inner {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }


    #{{ hero_id }} .brand-image-hero__grid {
      display: flex;

      flex-direction:
        {% if section.settings.mobile_image_first %}
          column
        {% else %}
          column-reverse
        {% endif %};

      gap: {{ section.settings.mobile_gap }}px;
    }


    #{{ hero_id }} .brand-image-hero__content,
    #{{ hero_id }} .brand-image-hero__visual {
      order: initial;
    }



    /* IMAGE */

    #{{ hero_id }} .brand-image-hero__visual {
      height: {{ section.settings.mobile_image_height }}px;

      border-radius: {{ section.settings.mobile_image_radius }}px;
    }



    /* CONTENU */

    #{{ hero_id }} .brand-image-hero__content {
      max-width: none;

      padding-top: 0;
      padding-bottom: 0;

      text-align:
        {{ section.settings.mobile_text_alignment }};
    }



    /* AVIS */

    #{{ hero_id }} .brand-image-hero__rating {
      justify-content:
        {% if section.settings.mobile_text_alignment == 'center' %}
          center
        {% elsif section.settings.mobile_text_alignment == 'right' %}
          flex-end
        {% else %}
          flex-start
        {% endif %};

      margin-bottom: {{ section.settings.mobile_rating_bottom_space }}px;
    }


    #{{ hero_id }} .brand-image-hero__stars {
      font-size: {{ section.settings.mobile_star_size }}px;
    }


    #{{ hero_id }} .brand-image-hero__rating-text {
      font-size: {{ section.settings.mobile_rating_text_size }}px;
    }



    /* SUR-TITRE */

    #{{ hero_id }} .brand-image-hero__eyebrow {
      margin-bottom: {{ section.settings.mobile_eyebrow_bottom_space }}px;

      font-size: {{ section.settings.mobile_eyebrow_size }}px;
    }



    /* TITRE */

    #{{ hero_id }} .brand-image-hero__heading {
      max-width: none;

      margin-bottom: {{ section.settings.mobile_heading_bottom_space }}px;

      font-size: {{ section.settings.mobile_heading_size }}px;

      line-height: {{ section.settings.mobile_heading_line_height }};

      letter-spacing: -0.5px;
    }



    /* DESCRIPTION */

    #{{ hero_id }} .brand-image-hero__description {
      max-width: none;

      margin-bottom: {{ section.settings.mobile_description_bottom_space }}px;

      font-size: {{ section.settings.mobile_description_size }}px;
    }



    /* CTA */

    #{{ hero_id }} .brand-image-hero__button {
      {% if section.settings.mobile_full_button %}
        width: 100%;
      {% endif %}

      align-self:
        {% if section.settings.mobile_text_alignment == 'center' %}
          center
        {% elsif section.settings.mobile_text_alignment == 'right' %}
          flex-end
        {% else %}
          flex-start
        {% endif %};

      min-height: {{ section.settings.mobile_button_height }}px;

      padding-left: {{ section.settings.mobile_button_horizontal_padding }}px;
      padding-right: {{ section.settings.mobile_button_horizontal_padding }}px;

      font-size: {{ section.settings.mobile_button_text_size }}px;
    }

  }

</style>


{% schema %}
{
  "name": "Image + contenu premium",
  "tag": "section",
  "class": "section-brand-image-hero",

  "settings": [

    {
      "type": "header",
      "content": "Image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "select",
      "id": "image_position",
      "label": "Position image sur PC",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "right"
    },

    {
      "type": "range",
      "id": "image_width",
      "label": "Largeur relative image",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Hauteur image PC",
      "min": 350,
      "max": 750,
      "step": 10,
      "unit": "px",
      "default": 600
    },

    {
      "type": "range",
      "id": "image_radius",
      "label": "Arrondi image PC",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Adaptation image",
      "options": [
        {
          "value": "cover",
          "label": "Remplir"
        },
        {
          "value": "contain",
          "label": "Afficher entière"
        }
      ],
      "default": "cover"
    },

    {
      "type": "select",
      "id": "image_position_y",
      "label": "Cadrage image",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Haut"
        },
        {
          "value": "bottom",
          "label": "Bas"
        }
      ],
      "default": "center"
    },


    {
      "type": "header",
      "content": "Avis"
    },

    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Afficher les étoiles",
      "default": true
    },

    {
      "type": "range",
      "id": "rating",
      "label": "Note",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },

    {
      "type": "text",
      "id": "rating_text",
      "label": "Texte avis",
      "default": "4,9/5 • Des centaines de clientes satisfaites"
    },

    {
      "type": "range",
      "id": "star_size",
      "label": "Taille étoiles PC",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "rating_text_size",
      "label": "Taille texte avis PC",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "rating_bottom_space",
      "label": "Espace sous les avis",
      "min": 5,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16
    },


    {
      "type": "header",
      "content": "Contenu"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Titre",
      "default": "Une peau plus lisse. Une technologie plus intelligente."
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Intégrez simplement la technologie LED à votre routine beauté et prenez soin de votre peau depuis chez vous.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir le masque"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },


    {
      "type": "header",
      "content": "Typographie PC"
    },

    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Taille petit titre",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },

    {
      "type": "range",
      "id": "eyebrow_spacing",
      "label": "Espacement petit titre",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre",
      "min": 28,
      "max": 68,
      "step": 1,
      "unit": "px",
      "default": 48
    },

    {
      "type": "select",
      "id": "heading_weight",
      "label": "Graisse titre",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "600"
    },

    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Interligne titre",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },

    {
      "type": "range",
      "id": "heading_width",
      "label": "Largeur maximale titre",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 580
    },

    {
      "type": "range",
      "id": "description_size",
      "label": "Taille description",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
      "type": "range",
      "id": "description_width",
      "label": "Largeur description",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 600
    },


    {
      "type": "header",
      "content": "Bouton"
    },

    {
      "type": "range",
      "id": "button_height",
      "label": "Hauteur bouton",
      "min": 40,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 54
    },

    {
      "type": "range",
      "id": "button_horizontal_padding",
      "label": "Largeur intérieure bouton",
      "min": 15,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 28
    },

    {
      "type": "range",
      "id": "button_text_size",
      "label": "Taille texte bouton",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondi bouton",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 30
    },

    {
      "type": "range",
      "id": "button_border_width",
      "label": "Épaisseur bordure bouton",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "color",
      "id": "button_border_color",
      "label": "Couleur bordure bouton",
      "default": "#C42F3B"
    },


    {
      "type": "header",
      "content": "Dimensions PC"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Largeur relative contenu",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },

    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largeur maximale contenu",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 650
    },

    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Espace contenu / image",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },

    {
      "type": "range",
      "id": "content_padding_vertical",
      "label": "Marge verticale contenu",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },

    {
      "type": "range",
      "id": "side_padding",
      "label": "Marges latérales PC",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute section",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse section",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "eyebrow_bottom_space",
      "label": "Espace sous petit titre",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "heading_bottom_space",
      "label": "Espace sous titre",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },

    {
      "type": "range",
      "id": "description_bottom_space",
      "label": "Espace sous description",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },


    {
      "type": "header",
      "content": "Couleurs"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Fond section",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#1A1A1A"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur principale",
      "default": "#C42F3B"
    },

