{% liquid
  assign results_id = 'results-image-' | append: section.id
%}

<section
  id="{{ results_id }}"
  class="results-image"
  style="
    --ri-bg: {{ section.settings.background_color }};
    --ri-text: {{ section.settings.text_color }};
    --ri-accent: {{ section.settings.accent_color }};
    --ri-muted: {{ section.settings.muted_color }};
    --ri-border: {{ section.settings.border_color }};
    --ri-max-width: {{ section.settings.max_width }}px;
  "
>

  <div class="results-image__container">

    <div class="results-image__grid">

      <!-- =========================================
           IMAGE
      ========================================== -->

      <div class="results-image__visual">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '500, 700, 900, 1200, 1600',
              sizes: '(max-width: 749px) 100vw, 45vw',
              class: 'results-image__image'
          }}

        {% else %}

          {{ 'image' | placeholder_svg_tag: 'results-image__placeholder' }}

        {% endif %}

      </div>


      <!-- =========================================
           CONTENU
      ========================================== -->

      <div class="results-image__content">

        {% if section.settings.eyebrow != blank %}
          <div class="results-image__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}


        {% if section.settings.heading != blank %}
          <h2 class="results-image__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.description != blank %}
          <div class="results-image__description">
            {{ section.settings.description }}
          </div>
        {% endif %}


        <!-- =========================================
             RÉSULTATS
        ========================================== -->

        <div class="results-image__stats">

          {% for block in section.blocks %}

            <div
              class="results-image__stat"
              {{ block.shopify_attributes }}
            >

              <div class="results-image__percentage">
                {{ block.settings.percentage }}
              </div>


              <div class="results-image__stat-content">

                {% if block.settings.text != blank %}
                  <div class="results-image__stat-text">
                    {{ block.settings.text }}
                  </div>
                {% endif %}

              </div>

            </div>

          {% endfor %}

        </div>


        {% if section.settings.footnote != blank %}
          <div class="results-image__footnote">
            {{ section.settings.footnote }}
          </div>
        {% endif %}

      </div>

    </div>

  </div>

</section>


<style>

  /* =====================================================
     GLOBAL
  ====================================================== */

  #{{ results_id }} {
    width: 100%;
    overflow: hidden;

    background: var(--ri-bg);
    color: var(--ri-text);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }


  #{{ results_id }} *,
  #{{ results_id }} *::before,
  #{{ results_id }} *::after {
    box-sizing: border-box;
  }


  #{{ results_id }} .results-image__container {
    width: 100%;
    max-width: var(--ri-max-width);

    margin: 0 auto;

    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }


  /* IMPORTANT :
     aucune police externe.
     La section reprend automatiquement la typographie du thème.
  */

  #{{ results_id }},
  #{{ results_id }} button,
  #{{ results_id }} input {
    font-family: inherit;
  }



  /* =====================================================
     GRID PC
  ====================================================== */

  #{{ results_id }} .results-image__grid {
    display: grid;

    grid-template-columns:
      minmax(0, {{ section.settings.image_column }}fr)
      minmax(0, 1fr);

    align-items: center;

    gap: {{ section.settings.desktop_gap }}px;
  }



  /* =====================================================
     IMAGE
  ====================================================== */

  #{{ results_id }} .results-image__visual {
    width: 100%;
    height: {{ section.settings.image_height }}px;

    overflow: hidden;

    border-radius: {{ section.settings.image_radius }}px;

    background: #f5f5f5;
  }


  #{{ results_id }} .results-image__image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }


  #{{ results_id }} .results-image__placeholder {
    width: 100%;
    height: 100%;

    display: block;
  }



  /* =====================================================
     CONTENU
  ====================================================== */

  #{{ results_id }} .results-image__content {
    width: 100%;

    max-width: {{ section.settings.content_width }}px;
  }



  /* =====================================================
     SUR-TITRE
  ====================================================== */

  #{{ results_id }} .results-image__eyebrow {
    margin-bottom: {{ section.settings.eyebrow_bottom_space }}px;

    color: var(--ri-accent);

    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 700;

    line-height: 1.2;

    letter-spacing: {{ section.settings.eyebrow_spacing }}px;

    text-transform: uppercase;
  }



  /* =====================================================
     TITRE
  ====================================================== */

  #{{ results_id }} .results-image__heading {
    margin:
      0
      0
      {{ section.settings.heading_bottom_space }}px;

    color: var(--ri-text);

    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};

    line-height: {{ section.settings.heading_line_height }};

    letter-spacing: -0.8px;
  }



  /* =====================================================
     DESCRIPTION
  ====================================================== */

  #{{ results_id }} .results-image__description {
    margin-bottom: {{ section.settings.description_bottom_space }}px;

    color: var(--ri-muted);

    font-size: {{ section.settings.description_size }}px;

    line-height: 1.5;
  }


  #{{ results_id }} .results-image__description p {
    margin: 0;
  }



  /* =====================================================
     STATISTIQUES
  ====================================================== */

  #{{ results_id }} .results-image__stats {
    width: 100%;
  }


  #{{ results_id }} .results-image__stat {
    display: grid;

    grid-template-columns:
      {{ section.settings.percentage_column_width }}px
      minmax(0, 1fr);

    align-items: center;

    gap: {{ section.settings.stat_gap }}px;

    min-height: {{ section.settings.stat_min_height }}px;

    padding:
      {{ section.settings.stat_padding_vertical }}px
      0;

    border-bottom:
      {{ section.settings.separator_width }}px
      solid
      var(--ri-border);
  }


  #{{ results_id }} .results-image__stat:first-child {
    border-top:
      {{ section.settings.separator_width }}px
      solid
      transparent;
  }



  /* POURCENTAGE */

  #{{ results_id }} .results-image__percentage {
    color: var(--ri-accent);

    font-size: {{ section.settings.percentage_size }}px;
    font-weight: {{ section.settings.percentage_weight }};

    line-height: 1;

    letter-spacing: -1.5px;

    white-space: nowrap;
  }



  /* TEXTE */

  #{{ results_id }} .results-image__stat-text {
    color: var(--ri-text);

    font-size: {{ section.settings.stat_text_size }}px;
    font-weight: {{ section.settings.stat_text_weight }};

    line-height: 1.4;
  }


  #{{ results_id }} .results-image__stat-text p {
    margin: 0;
  }



  /* =====================================================
     NOTE
  ====================================================== */

  #{{ results_id }} .results-image__footnote {
    margin-top: {{ section.settings.footnote_top_space }}px;

    color: var(--ri-muted);

    font-size: {{ section.settings.footnote_size }}px;

    line-height: 1.4;
  }


  #{{ results_id }} .results-image__footnote p {
    margin: 0;
  }



  /* =====================================================
     TABLETTE
  ====================================================== */

  @media screen and (max-width: 989px) {

    #{{ results_id }} .results-image__grid {
      gap: 40px;
    }


    #{{ results_id }} .results-image__visual {
      height: calc({{ section.settings.image_height }}px * 0.85);
    }


    #{{ results_id }} .results-image__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.85);
    }


    #{{ results_id }} .results-image__percentage {
      font-size: calc({{ section.settings.percentage_size }}px * 0.85);
    }

  }



  /* =====================================================
     MOBILE
  ====================================================== */

  @media screen and (max-width: 749px) {

    #{{ results_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    #{{ results_id }} .results-image__container {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }


    #{{ results_id }} .results-image__grid {
      display: flex;
      flex-direction: column;

      gap: {{ section.settings.mobile_gap }}px;
    }



    /* IMAGE MOBILE */

    #{{ results_id }} .results-image__visual {
      width: 100%;
      height: {{ section.settings.mobile_image_height }}px;

      border-radius: {{ section.settings.mobile_image_radius }}px;
    }



    /* CONTENU */

    #{{ results_id }} .results-image__content {
      width: 100%;
      max-width: none;
    }



    /* EYEBROW */

    #{{ results_id }} .results-image__eyebrow {
      margin-bottom: {{ section.settings.mobile_eyebrow_bottom_space }}px;

      font-size: {{ section.settings.mobile_eyebrow_size }}px;
    }



    /* TITRE */

    #{{ results_id }} .results-image__heading {
      margin-bottom: {{ section.settings.mobile_heading_bottom_space }}px;

      font-size: {{ section.settings.mobile_heading_size }}px;

      line-height: {{ section.settings.mobile_heading_line_height }};

      letter-spacing: -0.5px;
    }



    /* DESCRIPTION */

    #{{ results_id }} .results-image__description {
      margin-bottom: {{ section.settings.mobile_description_bottom_space }}px;

      font-size: {{ section.settings.mobile_description_size }}px;
    }



    /* STAT */

    #{{ results_id }} .results-image__stat {
      grid-template-columns:
        {{ section.settings.mobile_percentage_column_width }}px
        minmax(0, 1fr);

      gap: {{ section.settings.mobile_stat_gap }}px;

      min-height: auto;

      padding:
        {{ section.settings.mobile_stat_padding_vertical }}px
        0;
    }



    /* POURCENTAGE */

    #{{ results_id }} .results-image__percentage {
      font-size: {{ section.settings.mobile_percentage_size }}px;

      letter-spacing: -1px;
    }



    /* TEXTE */

    #{{ results_id }} .results-image__stat-text {
      font-size: {{ section.settings.mobile_stat_text_size }}px;

      line-height: 1.4;
    }



    /* NOTE */

    #{{ results_id }} .results-image__footnote {
      margin-top: {{ section.settings.mobile_footnote_top_space }}px;

      font-size: {{ section.settings.mobile_footnote_size }}px;
    }

  }



  /* =====================================================
     PETITS MOBILES
  ====================================================== */

  @media screen and (max-width: 390px) {

    #{{ results_id }} .results-image__stat {
      grid-template-columns:
        {{ section.settings.mobile_percentage_column_width }}px
        minmax(0, 1fr);
    }

  }

</style>


{% schema %}
{
  "name": "Image + résultats",
  "tag": "section",
  "class": "section-image-results",

  "settings": [

    {
      "type": "header",
      "content": "Image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image principale"
    },

    {
      "type": "range",
      "id": "image_column",
      "label": "Largeur relative image PC",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },

    {
      "type": "range",
      "id": "image_height",
      "label": "Hauteur image PC",
      "min": 350,
      "max": 750,
      "step": 10,
      "unit": "px",
      "default": 500
    },

    {
      "type": "range",
      "id": "image_radius",
      "label": "Arrondi image PC",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Adaptation image",
      "options": [
        {
          "value": "cover",
          "label": "Remplir"
        },
        {
          "value": "contain",
          "label": "Afficher entière"
        }
      ],
      "default": "cover"
    },

    {
      "type": "select",
      "id": "image_position",
      "label": "Position image",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Haut"
        },
        {
          "value": "bottom",
          "label": "Bas"
        },
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "center"
    },


    {
      "type": "header",
      "content": "Contenu"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "RÉSULTATS OBSERVÉS"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Titre",
      "default": "Des résultats visibles en seulement quelques semaines"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },

    {
      "type": "richtext",
      "id": "footnote",
      "label": "Note / précision"
    },


    {
      "type": "header",
      "content": "Typographie PC"
    },

    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Petit titre",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },

    {
      "type": "range",
      "id": "eyebrow_spacing",
      "label": "Espacement lettres",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "select",
      "id": "heading_weight",
      "label": "Graisse du titre",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "600"
    },

    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Interligne du titre",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },

    {
      "type": "range",
      "id": "description_size",
      "label": "Description",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "range",
      "id": "percentage_size",
      "label": "Pourcentages",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 54
    },

    {
      "type": "select",
      "id": "percentage_weight",
      "label": "Graisse pourcentages",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        },
        {
          "value": "700",
          "label": "Gras"
        }
      ],
      "default": "600"
    },

    {
      "type": "range",
      "id": "stat_text_size",
      "label": "Texte résultats",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "select",
      "id": "stat_text_weight",
      "label": "Graisse texte résultats",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-gras"
        }
      ],
      "default": "400"
    },

    {
      "type": "range",
      "id": "footnote_size",
      "label": "Taille note",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },


    {
      "type": "header",
      "content": "Résultats PC"
    },

    {
      "type": "range",
      "id": "percentage_column_width",
      "label": "Largeur colonne pourcentage",
      "min": 90,
      "max": 190,
      "step": 5,
      "unit": "px",
      "default": 130
    },

    {
      "type": "range",
      "id": "stat_gap",
      "label": "Espace pourcentage / texte",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "stat_min_height",
      "label": "Hauteur minimum ligne",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 105
    },

    {
      "type": "range",
      "id": "stat_padding_vertical",
      "label": "Marge verticale résultat",
      "min": 5,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "separator_width",
      "label": "Épaisseur séparateur",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1
    },


    {
      "type": "header",
      "content": "Dimensions PC"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1280
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Largeur contenu",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 620
    },

    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Espace image / contenu",
      "min": 30,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 70
    },

    {
      "type": "range",
      "id": "side_padding",
      "label": "Marges latérales",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },

    {
      "type": "range",
      "id": "eyebrow_bottom_space",
      "label": "Espace sous petit titre",
      "min": 4,
      "max": 25,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "heading_bottom_space",
      "label": "Espace sous titre",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "description_bottom_space",
      "label": "Espace sous description",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "footnote_top_space",
      "label": "Espace avant note",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },


    {
      "type": "header",
      "content": "Couleurs"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Fond section",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Texte principal",
      "default": "#1A1A1A"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur des pourcentages",
      "default": "#C42F3B"
    },

    {
      "type": "color",
      "id": "muted_color",
      "label": "Texte secondaire",
      "default": "#666666"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Séparateurs",
      "default": "#E7E1E1"
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Hauteur image mobile",
      "min": 280,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 400
    },

    {
      "type": "range",
      "id": "mobile_image_radius",
      "label": "Arrondi image mobile",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Taille titre mobile",
      "min": 24,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 30
    },

    {
      "type": "range",
      "id": "mobile_heading_line_height",
      "label": "Interligne titre mobile",
      "min": 1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.1
    },

    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "label": "Petit titre mobile",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10
    },

    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Description mobile",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "mobile_percentage_size",
      "label": "Pourcentages mobile",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "mobile_percentage_column_width",
      "label": "Largeur colonne pourcentage mobile",
      "min": 65,
