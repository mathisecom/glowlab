{% liquid
  assign section_id = 'before-after-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="ba-results"
  style="
    --ba-bg: {{ section.settings.background_color }};
    --ba-text: {{ section.settings.text_color }};
    --ba-muted: {{ section.settings.muted_color }};
    --ba-card-gap: {{ section.settings.desktop_gap }}px;
    --ba-radius: {{ section.settings.image_radius }}px;
    --ba-max-width: {{ section.settings.max_width }}px;
  "
>
  <div class="ba-results__container">

    <!-- =========================
         EN-TÊTE
    ========================== -->
    <div class="ba-results__header">

      {% if section.settings.eyebrow != blank %}
        <div class="ba-results__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ba-results__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ba-results__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    <!-- =========================
         SLIDER
    ========================== -->
    <div class="ba-results__slider-wrapper">

      <div
        class="ba-results__slider"
        data-ba-slider
      >

        {% for block in section.blocks %}

          <article
            class="ba-results__card"
            {{ block.shopify_attributes }}
          >

            <!-- IMAGE AVANT / APRÈS -->
            <div class="ba-results__media">

              <div class="ba-results__image ba-results__image--before">

                {% if block.settings.before_image != blank %}
                  {{
                    block.settings.before_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(max-width: 749px) 88vw, 31vw',
                      class: 'ba-results__img'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'ba-results__placeholder' }}
                {% endif %}

                <span class="ba-results__badge ba-results__badge--before">
                  {{ block.settings.before_label }}
                </span>

              </div>


              <div class="ba-results__divider"></div>


              <div class="ba-results__image ba-results__image--after">

                {% if block.settings.after_image != blank %}
                  {{
                    block.settings.after_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(max-width: 749px) 88vw, 31vw',
                      class: 'ba-results__img'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'ba-results__placeholder' }}
                {% endif %}

                <span class="ba-results__badge ba-results__badge--after">
                  {{ block.settings.after_label }}
                </span>

              </div>

            </div>


            <!-- CONTENU -->
            <div class="ba-results__content">

              {% if block.settings.title != blank %}
                <h3 class="ba-results__card-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}


              <div class="ba-results__customer">

                {% if block.settings.customer_name != blank %}
                  <span class="ba-results__customer-name">
                    {{ block.settings.customer_name }}
                  </span>
                {% endif %}


                {% if block.settings.verified_text != blank %}
                  {% if block.settings.customer_name != blank %}
                    <span class="ba-results__customer-separator">|</span>
                  {% endif %}

                  <span class="ba-results__verified">
                    {{ block.settings.verified_text }}

                    {% if block.settings.show_verified %}
                      <span class="ba-results__verified-icon">
                        <svg
                          viewBox="0 0 20 20"
                          aria-hidden="true"
                        >
                          <circle cx="10" cy="10" r="9"></circle>
                          <path d="M6 10.2l2.4 2.4L14.3 7"></path>
                        </svg>
                      </span>
                    {% endif %}
                  </span>
                {% endif %}

              </div>


              {% if block.settings.testimonial != blank %}
                <div class="ba-results__testimonial">
                  {{ block.settings.testimonial }}
                </div>
              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>


      <!-- FLÈCHE GAUCHE -->
      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="ba-results__arrow ba-results__arrow--prev"
          data-ba-prev
          aria-label="Résultat précédent"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>


        <!-- FLÈCHE DROITE -->
        <button
          type="button"
          class="ba-results__arrow ba-results__arrow--next"
          data-ba-next
          aria-label="Résultat suivant"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 6l6 6-6 6"></path>
          </svg>
        </button>
      {% endif %}

    </div>


    <!-- DOTS MOBILE -->
    {% if section.settings.show_mobile_dots %}
      <div
        class="ba-results__dots"
        data-ba-dots
      >
        {% for block in section.blocks %}
          <button
            type="button"
            class="ba-results__dot {% if forloop.first %}is-active{% endif %}"
            data-ba-dot="{{ forloop.index0 }}"
            aria-label="Voir le résultat {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>


<style>

  /* =====================================================
     SECTION
  ====================================================== */

  #{{ section_id }} {
    width: 100%;
    background: var(--ba-bg);
    color: var(--ba-text);

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    overflow: hidden;
  }


  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }


  #{{ section_id }} .ba-results__container {
    width: 100%;
    max-width: var(--ba-max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }



  /* =====================================================
     HEADER
  ====================================================== */

  #{{ section_id }} .ba-results__header {
    width: 100%;
    max-width: 620px;
    margin: 0 auto {{ section.settings.header_bottom_space }}px;
    text-align: center;
  }


  #{{ section_id }} .ba-results__eyebrow {
    margin: 0 0 14px;

    color: var(--ba-muted);

    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 500;
    line-height: 1.2;

    text-transform: uppercase;
  }


  #{{ section_id }} .ba-results__heading {
    margin: 0;

    color: var(--ba-text);

    font-size: {{ section.settings.heading_size }}px;
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.8px;
  }


  #{{ section_id }} .ba-results__description {
    max-width: 560px;

    margin:
      {{ section.settings.description_top_space }}px
      auto
      0;

    color: var(--ba-muted);

    font-size: {{ section.settings.description_size }}px;
    font-weight: 400;
    line-height: 1.35;
  }


  #{{ section_id }} .ba-results__description p {
    margin: 0;
  }



  /* =====================================================
     SLIDER
  ====================================================== */

  #{{ section_id }} .ba-results__slider-wrapper {
    position: relative;
    width: 100%;
  }


  #{{ section_id }} .ba-results__slider {
    display: flex;
    gap: var(--ba-card-gap);

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;
    -ms-overflow-style: none;

    overscroll-behavior-x: contain;
  }


  #{{ section_id }} .ba-results__slider::-webkit-scrollbar {
    display: none;
  }



  /* =====================================================
     CARTES
  ====================================================== */

  #{{ section_id }} .ba-results__card {
    flex:
      0
      0
      calc(
        (100% - (var(--ba-card-gap) * 2))
        / 3
      );

    min-width: 0;

    scroll-snap-align: start;
  }



  /* =====================================================
     AVANT APRÈS
  ====================================================== */

  #{{ section_id }} .ba-results__media {
    position: relative;

    width: 100%;
    height: {{ section.settings.image_height }}px;

    overflow: hidden;

    border-radius: var(--ba-radius);

    background: #f2f2f2;
  }


  #{{ section_id }} .ba-results__image {
    position: relative;

    width: 100%;
    height: 50%;

    overflow: hidden;
  }


  #{{ section_id }} .ba-results__img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    object-position: center;
  }


  #{{ section_id }} .ba-results__placeholder {
    width: 100%;
    height: 100%;

    display: block;

    background: #f2f2f2;
  }



  /* Ligne blanche entre avant et après */

  #{{ section_id }} .ba-results__divider {
    position: absolute;

    z-index: 5;

    top: 50%;
    left: 0;

    width: 100%;
    height: 2px;

    transform: translateY(-50%);

    background: {{ section.settings.divider_color }};

    pointer-events: none;
  }



  /* =====================================================
     BADGES
  ====================================================== */

  #{{ section_id }} .ba-results__badge {
    position: absolute;

    z-index: 4;

    left: 10px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 33px;

    padding: 6px 15px;

    border-radius: 999px;

    background: {{ section.settings.badge_background }};

    color: {{ section.settings.badge_text_color }};

    font-size: 14px;
    font-weight: 500;
    line-height: 1;
  }


  #{{ section_id }} .ba-results__badge--before {
    top: 9px;
  }


  #{{ section_id }} .ba-results__badge--after {
    bottom: 9px;
  }



  /* =====================================================
     TEXTE CARTE
  ====================================================== */

  #{{ section_id }} .ba-results__content {
    padding:
      {{ section.settings.card_text_top_space }}px
      11px
      0;
  }


  #{{ section_id }} .ba-results__card-title {
    margin: 0 0 10px;

    color: var(--ba-text);

    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.25px;
  }


  #{{ section_id }} .ba-results__customer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;

    margin-bottom: 15px;

    color: var(--ba-muted);

    font-size: {{ section.settings.customer_size }}px;
    line-height: 1.3;
  }


  #{{ section_id }} .ba-results__customer-separator {
    opacity: 0.75;
  }


  #{{ section_id }} .ba-results__verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }


  #{{ section_id }} .ba-results__verified-icon {
    width: 17px;
    height: 17px;

    display: inline-flex;

    flex: 0 0 17px;
  }


  #{{ section_id }} .ba-results__verified-icon svg {
    width: 100%;
    height: 100%;

    display: block;
  }


  #{{ section_id }} .ba-results__verified-icon circle {
    fill: #7c7c7c;
  }


  #{{ section_id }} .ba-results__verified-icon path {
    fill: none;

    stroke: white;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  #{{ section_id }} .ba-results__testimonial {
    color: var(--ba-text);

    font-size: {{ section.settings.testimonial_size }}px;
    font-weight: 400;
    line-height: 1.48;
  }


  #{{ section_id }} .ba-results__testimonial p {
    margin: 0;
  }



  /* =====================================================
     FLÈCHES
  ====================================================== */

  #{{ section_id }} .ba-results__arrow {
    position: absolute;

    z-index: 10;

    top: calc({{ section.settings.image_height }}px / 2);

    width: 42px;
    height: 42px;

    padding: 0;

    border: none;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.95);

    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.10);

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transform: translateY(-50%);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }


  #{{ section_id }} .ba-results__arrow:hover {
    transform: translateY(-50%) scale(1.04);
  }


  #{{ section_id }} .ba-results__arrow svg {
    width: 21px;
    height: 21px;

    fill: none;

    stroke: #222222;
    stroke-width: 2;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  #{{ section_id }} .ba-results__arrow--prev {
    left: -14px;
  }


  #{{ section_id }} .ba-results__arrow--next {
    right: -14px;
  }



  /* =====================================================
     DOTS
  ====================================================== */

  #{{ section_id }} .ba-results__dots {
    display: none;
  }



  /* =====================================================
     TABLETTE
  ====================================================== */

  @media screen and (max-width: 989px) {

    #{{ section_id }} .ba-results__container {
      padding-left: 20px;
      padding-right: 20px;
    }


    #{{ section_id }} .ba-results__card {
      flex: 0 0 calc((100% - var(--ba-card-gap)) / 2);
    }


    #{{ section_id }} .ba-results__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.88);
    }


    #{{ section_id }} .ba-results__arrow--prev {
      left: -5px;
    }


    #{{ section_id }} .ba-results__arrow--next {
      right: -5px;
    }

  }



  /* =====================================================
     MOBILE
  ====================================================== */

  @media screen and (max-width: 749px) {

    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    #{{ section_id }} .ba-results__container {
      padding-left: 0;
      padding-right: 0;
    }


    #{{ section_id }} .ba-results__header {
      max-width: none;

      margin-bottom: {{ section.settings.mobile_header_bottom_space }}px;

      padding-left: 20px;
      padding-right: 20px;
    }


    #{{ section_id }} .ba-results__eyebrow {
      margin-bottom: 10px;

      font-size: {{ section.settings.mobile_eyebrow_size }}px;
    }


    #{{ section_id }} .ba-results__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.12;
      letter-spacing: -0.5px;
    }


    #{{ section_id }} .ba-results__description {
      margin-top: 12px;

      padding-left: 6px;
      padding-right: 6px;

      font-size: {{ section.settings.mobile_description_size }}px;
      line-height: 1.4;
    }


    #{{ section_id }} .ba-results__slider {
      gap: {{ section.settings.mobile_gap }}px;

      padding-left: 20px;
      padding-right: 20px;

      scroll-padding-left: 20px;
    }


    #{{ section_id }} .ba-results__card {
      flex: 0 0 {{ section.settings.mobile_card_width }}%;

      scroll-snap-align: start;
    }


    #{{ section_id }} .ba-results__media {
      height: {{ section.settings.mobile_image_height }}px;
    }


    #{{ section_id }} .ba-results__content {
      padding:
        16px
        7px
        0;
    }


    #{{ section_id }} .ba-results__card-title {
      margin-bottom: 8px;

      font-size: {{ section.settings.mobile_card_title_size }}px;
    }


    #{{ section_id }} .ba-results__customer {
      margin-bottom: 12px;

      font-size: {{ section.settings.mobile_customer_size }}px;
    }


    #{{ section_id }} .ba-results__testimonial {
      font-size: {{ section.settings.mobile_testimonial_size }}px;
      line-height: 1.45;
    }


    #{{ section_id }} .ba-results__badge {
      min-height: 29px;

      padding: 5px 13px;

      font-size: 12px;
    }


    #{{ section_id }} .ba-results__arrow {
      display: none;
    }


    #{{ section_id }} .ba-results__dots {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 8px;

      margin-top: 24px;

      padding-left: 20px;
      padding-right: 20px;
    }


    #{{ section_id }} .ba-results__dot {
      width: 7px;
      height: 7px;

      padding: 0;

      border: 0;
      border-radius: 50%;

      background: #d0d0d0;

      cursor: pointer;

      transition:
        width 0.25s ease,
        background 0.25s ease,
        border-radius 0.25s ease;
    }


    #{{ section_id }} .ba-results__dot.is-active {
      width: 20px;

      border-radius: 20px;

      background: #222222;
    }

  }

</style>


<script>
  document.addEventListener('DOMContentLoaded', function () {

    const section = document.getElementById('{{ section_id }}');

    if (!section) return;


    const slider = section.querySelector('[data-ba-slider]');

    const cards = Array.from(
      section.querySelectorAll('.ba-results__card')
    );

    const previousButton =
      section.querySelector('[data-ba-prev]');

    const nextButton =
      section.querySelector('[data-ba-next]');

    const dots = Array.from(
      section.querySelectorAll('[data-ba-dot]')
    );


    if (!slider || !cards.length) return;



    /* ==============================
       CALCUL DU DÉPLACEMENT
    ============================== */

    function getScrollAmount() {

      if (!cards[0]) return 0;

      const sliderStyles =
        window.getComputedStyle(slider);

      const gap =
        parseFloat(sliderStyles.columnGap) ||
        parseFloat(sliderStyles.gap) ||
        0;

      return cards[0].getBoundingClientRect().width + gap;

    }



    /* ==============================
       FLÈCHES
    ============================== */

    if (previousButton) {

      previousButton.addEventListener('click', function () {

        slider.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });

      });

    }


    if (nextButton) {

      nextButton.addEventListener('click', function () {

        slider.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });

      });

    }



    /* ==============================
       DOTS
    ============================== */

    function setActiveDot(index) {

      dots.forEach(function (dot, dotIndex) {

        dot.classList.toggle(
          'is-active',
          dotIndex === index
        );

      });

    }


    dots.forEach(function (dot) {

      dot.addEventListener('click', function () {

        const index =
          parseInt(
            dot.getAttribute('data-ba-dot'),
            10
          );

        if (!cards[index]) return;


        slider.scrollTo({
          left: cards[index].offsetLeft - slider.offsetLeft,
          behavior: 'smooth'
        });


        setActiveDot(index);

      });

    });



    /* ==============================
       SLIDE ACTIF
    ============================== */

    let scrollTimeout;


    slider.addEventListener('scroll', function () {

      clearTimeout(scrollTimeout);


      scrollTimeout = setTimeout(function () {

        let closestIndex = 0;
        let closestDistance = Infinity;


        cards.forEach(function (card, index) {

          const distance = Math.abs(
            card.offsetLeft -
            slider.offsetLeft -
            slider.scrollLeft
          );


          if (distance < closestDistance) {

            closestDistance = distance;
            closestIndex = index;

          }

        });


        setActiveDot(closestIndex);

      }, 60);

    });

  });
</script>


{% schema %}
{
  "name": "Résultats avant / après",
  "tag": "section",
  "class": "section-before-after-results",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "RÉSULTATS AUTHENTIQUES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Résultats avant après"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Découvrez les résultats de nos clients et leur expérience.</p>"
    },

    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1420
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Espacement entre les cartes",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Hauteur image PC",
      "min": 300,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arrondi des images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Taille petit titre",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille titre",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Taille description",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Titre des résultats",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "customer_size",
      "label": "Informations client",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "testimonial_size",
      "label": "Témoignage",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute PC",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse PC",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "header_bottom_space",
      "label": "Espace sous l'en-tête",
      "min": 20,
