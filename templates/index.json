entColor\"\n                  stroke-width=\"2\">\n                </circle>\n\n                <path\n                  d=\"M24 47c3 4 13 4 16 0\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\">\n                </path>\n\n              </svg>\n\n            </div>\n\n            <div class=\"flexilee-benefits__content\">\n\n              <div class=\"flexilee-benefits__title\">\n                SERVICE CLIENT\n              </div>\n\n              <div class=\"flexilee-benefits__text\">\n                Lun–Ven | 9h–12h / 13h–17h\n              </div>\n\n            </div>\n\n          </div>\n\n\n          <!-- RETOUR FACILE -->\n          <div class=\"flexilee-benefits__item\">\n\n            <div class=\"flexilee-benefits__icon\">\n\n              <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n\n                <rect\n                  x=\"13\"\n                  y=\"11\"\n                  width=\"38\"\n                  height=\"42\"\n                  rx=\"3\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\">\n                </rect>\n\n                <path\n                  d=\"M25 25h18M25 33h13\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\">\n                </path>\n\n                <path\n                  d=\"M26 45H12l6-6M12 45l6 6\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\">\n                </path>\n\n              </svg>\n\n            </div>\n\n            <div class=\"flexilee-benefits__content\">\n\n              <div class=\"flexilee-benefits__title\">\n                RETOUR FACILE\n              </div>\n\n              <div class=\"flexilee-benefits__text\">\n                sous 30 jours\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n\n      <!-- POINTS MOBILE -->\n      <div class=\"flexilee-benefits__dots\" aria-label=\"Navigation\">\n\n        <button\n          class=\"flexilee-benefits__dot is-active\"\n          type=\"button\"\n          aria-label=\"Livraison rapide\">\n        </button>\n\n        <button\n          class=\"flexilee-benefits__dot\"\n          type=\"button\"\n          aria-label=\"Service client\">\n        </button>\n\n        <button\n          class=\"flexilee-benefits__dot\"\n          type=\"button\"\n          aria-label=\"Retour facile\">\n        </button>\n\n      </div>\n\n    </section>\n\n\n    <style>\n\n      /* ==================================\n         GLOBAL\n      ================================== */\n\n      .flexilee-benefits {\n\n        --benefit-text: #202020;\n        --benefit-muted: #555555;\n        --benefit-circle: #f2f0ed;\n        --benefit-border: #d8d5d1;\n\n        width: 100%;\n\n        background: #FFFFFF;\n\n        font-family: \"Bricolage Grotesque\", sans-serif;\n\n        overflow: hidden;\n\n        margin: 0;\n\n        padding: 0;\n\n      }\n\n\n      .flexilee-benefits *,\n      .flexilee-benefits *::before,\n      .flexilee-benefits *::after {\n\n        box-sizing: border-box;\n\n        font-family: \"Bricolage Grotesque\", sans-serif;\n\n      }\n\n\n\n      /* ==================================\n         DESKTOP\n      ================================== */\n\n      .flexilee-benefits__viewport {\n\n        width: 100%;\n\n        margin: 0;\n\n        padding: 0;\n\n      }\n\n\n      .flexilee-benefits__track {\n\n        width: 100%;\n\n        max-width: 1400px;\n\n        min-height: 82px;\n\n        margin: 0 auto;\n\n        /* Padding du dessus réduit */\n        padding: 2px 20px 8px;\n\n        display: grid;\n\n        grid-template-columns: repeat(3, 1fr);\n\n        align-items: center;\n\n      }\n\n\n\n      .flexilee-benefits__item {\n\n        position: relative;\n\n        display: flex;\n\n        align-items: center;\n\n        justify-content: center;\n\n        min-width: 0;\n\n        padding: 5px 35px;\n\n        gap: 17px;\n\n      }\n\n\n\n      /* SÉPARATEURS */\n\n      .flexilee-benefits__item:not(:last-child)::after {\n\n        content: \"\";\n\n        position: absolute;\n\n        right: 0;\n\n        top: 50%;\n\n        width: 1px;\n\n        height: 52px;\n\n        background: var(--benefit-border);\n\n        transform: translateY(-50%);\n\n      }\n\n\n\n      /* ==================================\n         ICÔNES\n      ================================== */\n\n      .flexilee-benefits__icon {\n\n        width: 58px;\n\n        height: 58px;\n\n        flex: 0 0 58px;\n\n        border-radius: 50%;\n\n        background: var(--benefit-circle);\n\n        display: flex;\n\n        align-items: center;\n\n        justify-content: center;\n\n        color: #4f4f4f;\n\n      }\n\n\n      .flexilee-benefits__icon svg {\n\n        width: 30px;\n\n        height: 30px;\n\n        display: block;\n\n      }\n\n\n\n      /* ==================================\n         TEXTE\n      ================================== */\n\n      .flexilee-benefits__content {\n\n        min-width: 0;\n\n        line-height: 1.2;\n\n      }\n\n\n      .flexilee-benefits__title {\n\n        color: var(--benefit-text);\n\n        font-size: 12px;\n\n        font-weight: 700;\n\n        line-height: 1.25;\n\n        letter-spacing: -0.1px;\n\n        text-transform: uppercase;\n\n        margin-bottom: 5px;\n\n        white-space: nowrap;\n\n      }\n\n\n      .flexilee-benefits__text {\n\n        color: var(--benefit-muted);\n\n        font-size: 12px;\n\n        font-weight: 400;\n\n        line-height: 1.3;\n\n        white-space: nowrap;\n\n      }\n\n\n\n      /* POINTS CACHÉS SUR PC */\n\n      .flexilee-benefits__dots {\n\n        display: none;\n\n      }\n\n\n\n      /* ==================================\n         TABLETTE\n      ================================== */\n\n      @media screen and (max-width: 900px) and (min-width: 701px) {\n\n        .flexilee-benefits__track {\n\n          padding-top: 2px;\n\n          padding-left: 10px;\n\n          padding-right: 10px;\n\n          padding-bottom: 7px;\n\n        }\n\n\n        .flexilee-benefits__item {\n\n          padding-left: 18px;\n\n          padding-right: 18px;\n\n          gap: 12px;\n\n        }\n\n\n        .flexilee-benefits__icon {\n\n          width: 50px;\n\n          height: 50px;\n\n          flex-basis: 50px;\n\n        }\n\n\n        .flexilee-benefits__icon svg {\n\n          width: 26px;\n\n          height: 26px;\n\n        }\n\n\n        .flexilee-benefits__title {\n\n          font-size: 10px;\n\n        }\n\n\n        .flexilee-benefits__text {\n\n          font-size: 10px;\n\n        }\n\n      }\n\n\n\n      /* ==================================\n         MOBILE\n      ================================== */\n\n      @media screen and (max-width: 700px) {\n\n        .flexilee-benefits {\n\n          /* Aucun espace en haut */\n          padding: 0 0 6px;\n\n          margin: 0;\n\n          background: #FFFFFF;\n\n        }\n\n\n        .flexilee-benefits__viewport {\n\n          width: 100%;\n\n          overflow-x: auto;\n\n          scrollbar-width: none;\n\n          -ms-overflow-style: none;\n\n          scroll-snap-type: x mandatory;\n\n          scroll-behavior: smooth;\n\n          overscroll-behavior-x: contain;\n\n          padding: 0;\n\n          margin: 0;\n\n        }\n\n\n        .flexilee-benefits__viewport::-webkit-scrollbar {\n\n          display: none;\n\n        }\n\n\n        .flexilee-benefits__track {\n\n          display: flex;\n\n          align-items: center;\n\n          width: max-content;\n\n          max-width: none;\n\n          min-height: 62px;\n\n          margin: 0;\n\n          padding: 0;\n\n        }\n\n\n        .flexilee-benefits__item {\n\n          justify-content: flex-start;\n\n          width: 250px;\n\n          min-width: 250px;\n\n          height: 60px;\n\n          padding: 0 18px;\n\n          gap: 12px;\n\n          scroll-snap-align: start;\n\n        }\n\n\n        .flexilee-benefits__item:not(:last-child)::after {\n\n          height: 43px;\n\n        }\n\n\n        .flexilee-benefits__icon {\n\n          width: 48px;\n\n          height: 48px;\n\n          flex: 0 0 48px;\n\n        }\n\n\n        .flexilee-benefits__icon svg {\n\n          width: 25px;\n\n          height: 25px;\n\n        }\n\n\n        .flexilee-benefits__title {\n\n          font-size: 10px;\n\n          margin-bottom: 4px;\n\n          letter-spacing: -0.1px;\n\n        }\n\n\n        .flexilee-benefits__text {\n\n          font-size: 10px;\n\n        }\n\n\n\n        /* ==================================\n           POINTS MOBILE\n        ================================== */\n\n        .flexilee-benefits__dots {\n\n          height: 12px;\n\n          display: flex;\n\n          align-items: center;\n\n          justify-content: center;\n\n          gap: 11px;\n\n          margin: 0;\n\n          padding: 0;\n\n        }\n\n\n        .flexilee-benefits__dot {\n\n          appearance: none;\n\n          -webkit-appearance: none;\n\n          width: 6px;\n\n          height: 6px;\n\n          padding: 0;\n\n          margin: 0;\n\n          border: none;\n\n          border-radius: 50%;\n\n          background: #bcbcbc;\n\n          cursor: pointer;\n\n          transition:\n            transform 0.2s ease,\n            background 0.2s ease;\n\n        }\n\n\n        .flexilee-benefits__dot.is-active {\n\n          background: #111111;\n\n          transform: scale(1.08);\n\n        }\n\n      }\n\n\n\n      /* ==================================\n         PETITS MOBILES\n      ================================== */\n\n      @media screen and (max-width: 390px) {\n\n        .flexilee-benefits__item {\n\n          width: 225px;\n\n          min-width: 225px;\n\n          padding-left: 14px;\n\n          padding-right: 14px;\n\n          gap: 10px;\n\n        }\n\n\n        .flexilee-benefits__icon {\n\n          width: 44px;\n\n          height: 44px;\n\n          flex-basis: 44px;\n\n        }\n\n\n        .flexilee-benefits__icon svg {\n\n          width: 23px;\n\n          height: 23px;\n\n        }\n\n\n        .flexilee-benefits__title,\n        .flexilee-benefits__text {\n\n          font-size: 9px;\n\n        }\n\n      }\n\n    </style>\n\n\n    <script>\n\n      document.addEventListener(\"DOMContentLoaded\", function () {\n\n        const section =\n          document.querySelector(\"#flexilee-benefits\");\n\n        if (!section) return;\n\n\n        const viewport =\n          section.querySelector(\n            \".flexilee-benefits__viewport\"\n          );\n\n\n        const items =\n          section.querySelectorAll(\n            \".flexilee-benefits__item\"\n          );\n\n\n        const dots =\n          section.querySelectorAll(\n            \".flexilee-benefits__dot\"\n          );\n\n\n        if (!viewport || !items.length || !dots.length) {\n\n          return;\n\n        }\n\n\n\n        function setActiveDot(index) {\n\n          dots.forEach(function(dot, dotIndex) {\n\n            if (dotIndex === index) {\n\n              dot.classList.add(\"is-active\");\n\n            } else {\n\n              dot.classList.remove(\"is-active\");\n\n            }\n\n          });\n\n        }\n\n\n\n        /* CLIC SUR LES POINTS */\n\n        dots.forEach(function(dot, index) {\n\n          dot.addEventListener(\"click\", function() {\n\n            viewport.scrollTo({\n\n              left: items[index].offsetLeft,\n\n              behavior: \"smooth\"\n\n            });\n\n\n            setActiveDot(index);\n\n          });\n\n        });\n\n\n\n        /* DÉTECTION DU SLIDE ACTIF */\n\n        let scrollTimer;\n\n\n        viewport.addEventListener(\"scroll\", function() {\n\n          clearTimeout(scrollTimer);\n\n\n          scrollTimer = setTimeout(function() {\n\n            let closestIndex = 0;\n\n            let closestDistance = Infinity;\n\n\n            items.forEach(function(item, index) {\n\n              const distance = Math.abs(\n                item.offsetLeft - viewport.scrollLeft\n              );\n\n\n              if (distance < closestDistance) {\n\n                closestDistance = distance;\n\n                closestIndex = index;\n\n              }\n\n            });\n\n\n            setActiveDot(closestIndex);\n\n          }, 60);\n\n        });\n\n      });\n\n    </script>\n\n  </div>\n</div>"
          }
        },
